digraph G {graph [rankdir=TB,bgcolor="transparent",nodesep=.19,ranksep=.29,pad=.05];node [shape=record,style="rounded,filled",fillcolor="#f3f6fa",color="#839ab1",fontname="Arial",fontsize=9,margin=".08,.04"];edge [color="#627c91",arrowsize=.55,fontsize=9,fontname="Arial"]; patient [label="Patient|Child (NHI)"]; pd [label="PlanDefinition|B4SC workflow template"]; cp [label="CarePlan|Child's B4SC plan"]; task [label="Task|Consent / Forms / V&H / Nurse / Referral"]; qr [label="QuestionnaireResponse|Answers and authorship"]; questionnaire [label="Questionnaire|Form definition"]; rp [label="RelatedPerson|Parent / caregiver (where needed)"]; pd -> cp [label="applied by scheduler",style=dashed]; patient -> cp [label="subject",dir=back]; cp -> task [label="Task.basedOn",dir=back]; task -> qr [label="evidence / output",style=dashed]; questionnaire -> qr [label="questionnaire",dir=back]; patient -> qr [label="subject",dir=back]; rp -> qr [label="author where applicable",style=dashed]; }