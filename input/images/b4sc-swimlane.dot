digraph G {graph [rankdir=LR,bgcolor="transparent",nodesep=.22,ranksep=.4,pad=.06];node [shape=box,style="rounded,filled",fillcolor="#eff4fa",color="#8199af",fontname="Arial",fontsize=9,margin=".08,.04"];edge [color="#60798e",arrowsize=.55,fontsize=9,fontname="Arial"]; subgraph cluster1 {label="Cohorts / Scheduler";fontsize=9;style="rounded,dashed";color="#b8c7d4"; a [label="Identify due child"]; b [label="Create / reuse\nCarePlan + Tasks"];a->b;} subgraph cluster2 {label="Coordinator / PMS";fontsize=9;style="rounded,dashed";color="#b8c7d4"; c [label="Review assignment\nand initiate forms"]; } subgraph cluster3 {label="Whānau / screening workforce";fontsize=9;style="rounded,dashed";color="#b8c7d4"; d [label="Consent, forms and V&H\n(any order / concurrent)"]; } subgraph cluster4 {label="Nurse";fontsize=9;style="rounded,dashed";color="#b8c7d4"; e [label="Review and final\nclinical evaluation"]; } subgraph cluster5 {label="FHIR / summary / follow-up";fontsize=9;style="rounded,dashed";color="#b8c7d4"; f [label="Record responses\nand task progress"]; g [label="Produce summaries"]; h [label="Track referrals\nthen close CarePlan"];f->g->h;} b->c->d->e->f; }