digraph G {graph [rankdir=TB,bgcolor="transparent",nodesep=.22,ranksep=.35,pad=.06];node [shape=box,style="rounded,filled",fillcolor="#eff4fa",color="#8199af",fontname="Arial",fontsize=9,margin=".12,.06"];edge [color="#60798e",arrowsize=.55,fontsize=9,fontname="Arial"]; a [label="Cohorts: child eligible"]; b [label="Scheduler: find existing B4SC CarePlan\nor create CarePlan and initial Tasks"]; c [label="Coordinator: nomination / assignment\nand progress monitoring"]; {rank=same; d [label="Consent",fillcolor="#e1efe8"]; e [label="Whānau forms",fillcolor="#e1efe8"]; f [label="Vision & hearing",fillcolor="#e1efe8"]} g [label="Nurse review and evaluation\nFinal clinical completion gate",fillcolor="#e1efe8"]; h [label="Clinical + whānau summaries"]; i [label="CarePlan closure after required\nreferral follow-up resolved",fillcolor="#fff3df"]; a -> b -> c; c -> d; c -> e; c -> f; d -> g; e -> g; f -> g; g -> h -> i; }