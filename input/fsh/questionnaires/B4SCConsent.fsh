// DRAFT: derived from September 2022 B4 School Check consent form. Review before use.
Instance: B4SCConsent
InstanceOf: Questionnaire
Usage: #definition
* status = #draft
* version = "0.2.0"
* date = "2026-11-12"
* name = "B4SCConsent"
* title = "B4 School Check consent"
* description = "Digital draft based on September 2022 consent form; requires review."
* item[0].linkId = "introduction"
* item[0].text = "About the B4 School Check"
* item[0].type = #group
* item[0].item[0].linkId = "intro"
* item[0].item[0].text = "The B4 School Check is a free health and development check for children around four years of age. It involves a nurse visit, vision and hearing assessment, and questionnaires about development and wellbeing."
* item[0].item[0].type = #display
* item[1].linkId = "child-details"
* item[1].text = "Child’s details"
* item[1].type = #group
* item[1].item[0].linkId = "child-name"
* item[1].item[0].text = "Name of child"
* item[1].item[0].type = #string
* item[1].item[0].required = true
* item[1].item[1].linkId = "child-dob"
* item[1].item[1].text = "Date of birth"
* item[1].item[1].type = #date
* item[1].item[1].required = true
* item[1].item[2].linkId = "birth-certificate-name"
* item[1].item[2].text = "Name on birth certificate (if different)"
* item[1].item[2].type = #string
* item[1].item[3].linkId = "child-address"
* item[1].item[3].text = "Usual home address of child"
* item[1].item[3].type = #text
* item[1].item[4].linkId = "contact-mobile"
* item[1].item[4].text = "Contact phone number (mobile)"
* item[1].item[4].type = #string
* item[1].item[5].linkId = "previous-check"
* item[1].item[5].text = "Has your child had a B4 School Check?"
* item[1].item[5].type = #choice
* item[1].item[5].required = true
* item[1].item[5].answerOption[0].valueCoding.code = #yes
* item[1].item[5].answerOption[0].valueCoding.display = "Yes"
* item[1].item[5].answerOption[1].valueCoding.code = #no
* item[1].item[5].answerOption[1].valueCoding.display = "No"
* item[2].linkId = "consent-information"
* item[2].text = "Information to read before consenting"
* item[2].type = #group
* item[2].item[0].linkId = "previous-check-note"
* item[2].item[0].text = "If your child has already had a B4 School Check, do not complete another consent form; contact your provider."
* item[2].item[0].type = #display
* item[2].item[1].linkId = "check-involves"
* item[2].item[1].text = "The B4 School Check usually takes about 45 minutes. A nurse completes the child health check, families complete development and behaviour questionnaires, and a vision and hearing technician assesses vision and hearing."
* item[2].item[1].type = #display
* item[2].item[2].linkId = "sharing"
* item[2].item[2].text = "The check results are shared with the child’s family doctor. Vision and hearing results may be shared with the child’s early learning service or school. Other school information is not shared without permission. Further referrals are discussed with the parent or caregiver."
* item[2].item[2].type = #display
* item[2].item[3].linkId = "privacy"
* item[2].item[3].text = "The child’s identity and check results are recorded in the B4 School Check information system. Information is used for care, programme monitoring and authorised research subject to applicable privacy and access controls. Parents and guardians can request access to and correction of their child’s information."
* item[2].item[3].type = #display
* item[2].item[4].linkId = "privacy-detail"
* item[2].item[4].text = "The September 2022 source form describes retention of check information for at least ten years, authorised research access, and possible sharing with Oranga Tamariki where child safety is at risk. Confirm current policy and wording before publication."
* item[2].item[4].type = #display
* item[3].linkId = "parent-consent"
* item[3].text = "Parent or legal guardian consent"
* item[3].type = #group
* item[3].item[0].linkId = "signatory-name"
* item[3].item[0].text = "Name of parent or legal guardian"
* item[3].item[0].type = #string
* item[3].item[0].required = true
* item[3].item[1].linkId = "guardian-child-name"
* item[3].item[1].text = "Name of child for whom consent is given"
* item[3].item[1].type = #string
* item[3].item[1].required = true
* item[3].item[2].linkId = "declaration"
* item[3].item[2].text = "I confirm that I am the parent or legal guardian of this child. I understand what the B4 School Check involves, have read how the information will be used, and consent to the B4 School Check."
* item[3].item[2].type = #display
* item[3].item[3].linkId = "consent-given"
* item[3].item[3].text = "I give consent to the B4 School Check"
* item[3].item[3].type = #choice
* item[3].item[3].required = true
* item[3].item[3].answerOption[0].valueCoding.code = #yes
* item[3].item[3].answerOption[0].valueCoding.display = "Yes, I consent"
* item[3].item[3].answerOption[1].valueCoding.code = #no
* item[3].item[3].answerOption[1].valueCoding.display = "No, I do not consent"
* item[3].item[4].linkId = "consent-date"
* item[3].item[4].text = "Date"
* item[3].item[4].type = #date
* item[3].item[4].required = true
* item[4].linkId = "office-use"
* item[4].text = "For office use only"
* item[4].type = #group
* item[4].item[0].linkId = "consent-checked-by"
* item[4].item[0].text = "Checked by"
* item[4].item[0].type = #string
